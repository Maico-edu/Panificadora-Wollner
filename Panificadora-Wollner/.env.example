# Copie para .env.local (desenvolvimento) e cadastre as mesmas variáveis na Vercel.
# NUNCA coloque senhas reais neste arquivo de exemplo.

# Nome de usuário do painel
ADMIN_USER=

# Gere com:  npm run hash-password -- "sua-senha-forte"
ADMIN_PASSWORD_HASH=

# Texto aleatório longo. O mesmo comando acima gera um.
SESSION_SECRET=

# Vercel Blob: criado e preenchido automaticamente pela Vercel ao conectar a loja
# (Storage > Blob) ao projeto. Só é necessário aqui se quiser testar o Blob localmente.
# BLOB_READ_WRITE_TOKEN=
